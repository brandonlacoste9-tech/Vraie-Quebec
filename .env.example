# App URL (used for Stripe Checkout success/cancel redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for Stripe webhooks to update subscriptions (server only)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Price ID for the monthly membership (e.g. price_xxx from Products → Pricing)
STRIPE_PRICE_ID=

# Webhook signing secret from https://dashboard.stripe.com/webhooks (endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=

# Membership — Payment Link where customers choose $9.99 (Initiés) or $24.99 (Élite)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_dRm4gB8TM44V29r7xA7ss02

# Membership — Élite only ($24.99)
NEXT_PUBLIC_STRIPE_MEMBERSHIP_PAYMENT_LINK_ELITE=https://buy.stripe.com/test_aFa3cxfiafNDcO55ps7ss03

# Publicité — forfait Présence / Vedette (Stripe Payment Links)
NEXT_PUBLIC_STRIPE_ADS_PAYMENT_LINK=https://buy.stripe.com/test_dRmaEZ5HA30R01j7xA7ss00
NEXT_PUBLIC_STRIPE_ADS_PAYMENT_LINK_VEDETTE=https://buy.stripe.com/test_eVqeVfee61WNaFX2dg7ss01
